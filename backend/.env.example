# URBAN-EYE AI backend configuration
# Copy this file to .env if you want to override defaults (all values below are
# optional — the app works out of the box with SQLite and no external services).

# CORS origin allowed to call this API (frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Demo login (already seeded into the database — change here + reseed if needed)
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123
